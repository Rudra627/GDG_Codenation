# Server
PORT=5000
NODE_ENV=development

# Database (MySQL for local, or set DB_URL for Supabase/PostgreSQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=leetcode_clone

# For Supabase/PostgreSQL (uncomment and fill to override MySQL above)
# DB_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# JWT - CHANGE THIS to a strong random string in production!
JWT_SECRET=change_this_to_a_random_secret_key

# Judge0 API (for code execution - REQUIRED for submissions to work)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here

# Email (for notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
